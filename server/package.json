    "test:http": "node -r dotenv/config --test tests/http.integration.test.js dotenv_config_quiet=true",
    "test:rf5:integration": "node -r dotenv/config --test tests/rf5.integration.test.js dotenv_config_quiet=true",
    "test:rf5:http": "node -r dotenv/config --test tests/rf5.http.test.js dotenv_config_quiet=true",
    "test:rf8:integration": "node -r dotenv/config --test tests/rf8.integration.test.js dotenv_config_quiet=true",
    "db:migrate": "node db/migrate.js",
    "test:inventario:unit": "node --test tests/inventarioRepository.test.js",
    "test:inventario:http:validation": "node --test tests/inventario.http.validation.test.js",
    "test:inventario:integration": "node -r dotenv/config --test tests/inventario.integration.test.js dotenv_config_quiet=true",
    "test:rf14:integration": "node -r dotenv/config --test tests/rf14.integration.test.js dotenv_config_quiet=true"
  },
