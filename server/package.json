  "description": "Backend API para proyecto ISW",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test tests/liquidacion.test.js tests/recargoPremium.test.js tests/rf8.test.js tests/rf14.test.js",
    "test:rf8": "node --test tests/rf8.test.js",
