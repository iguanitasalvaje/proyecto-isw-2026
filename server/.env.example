# =============================================================================
# SIX SEVEN TRANSMISIONES - VARIABLES DE ENTORNO DEL SERVIDOR (server/.env)
# =============================================================================
# Copia este archivo como 'server/.env' y completa con tus valores locales.
# NUNCA compartas ni subas tu archivo 'server/.env' a GitHub.

# -----------------------------------------------------------------------------
# 1. BASE DE DATOS PRINCIPAL (DESARROLLO O PRODUCCIÓN)
# -----------------------------------------------------------------------------
# Sin conexión predeterminada. Usar exclusivamente entornos autorizados.
# Opción A: PostgreSQL Local (por ejemplo, instalado en tu computadora Windows)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_base>
DATABASE_URL=postgresql://postgres:tu_password_local@127.0.0.1:5432/sixseven_db

# Opción B: PostgreSQL en la Nube (Supabase, Neon, Render, AWS RDS, Railway, etc.)
# DATABASE_URL=postgresql://usuario:clave@ep-proyecto.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE SSL / TLS (PARA BASES DE DATOS EN LA NUBE)
# -----------------------------------------------------------------------------
# En desarrollo local: dejar en false.
# En la nube (Supabase, Neon, etc.): activar en true si tu proveedor exige SSL.
DATABASE_SSL=false

# Validación de certificados CA del proveedor (true por defecto).
# Si usas conexiones con pooler o certificados autofirmados, puedes colocar false.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Límite máximo de conexiones concurrentes en el pool (opcional, 10 por defecto)
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# 3. BASE DE DATOS EXCLUSIVA PARA PRUEBAS AUTOMATIZADAS (TESTS)
# -----------------------------------------------------------------------------
# Base exclusiva de pruebas; el test crea y elimina un esquema propio.
# OBLIGATORIO para ejecutar 'npm run test:integration' o 'npm run test:http'.
# REGLA DE SEGURIDAD: TEST_DATABASE_URL NUNCA debe ser idéntica a DATABASE_URL.
# Las pruebas crean y eliminan esquemas temporales de forma destructiva.
TEST_DATABASE_URL=postgresql://postgres:tu_password_local@127.0.0.1:5432/sixseven_test

# -----------------------------------------------------------------------------
# 4. AUTENTICACIÓN Y SEGURIDAD JWT (RF1)
# -----------------------------------------------------------------------------
# Clave secreta para firmar y validar tokens de sesión JWT.
# Genera una cadena aleatoria y compleja para tu entorno.
JWT_SECRET=tu_clave_secreta_jwt_minimo_32_caracteres_aleatorios

# -----------------------------------------------------------------------------
# 5. PUERTO DEL SERVIDOR BACKEND
# -----------------------------------------------------------------------------
PORT=1303

# -----------------------------------------------------------------------------
# 6. ENTORNO DE EJECUCIÓN
# -----------------------------------------------------------------------------
NODE_ENV=development
